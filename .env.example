# Supabase bağlantı bilgileri.
# Gerçek değerleri .env.local dosyasına yazın (bu dosya örnektir, gerçek anahtar içermez).
# Değerleri Supabase panelinden alacağız: Project Settings > API.

# Supabase proje URL'i (tarayıcıda kullanılır, gizli değildir)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (anon) anahtar — tarayıcıda kullanılır, RLS ile korunur
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret (service role) anahtar — YALNIZCA sunucuda kullanılır.
# Kullanıcı oluşturma gibi yetkili işlemler için. Tarayıcıya ASLA sızdırılmaz.
SUPABASE_SECRET_KEY=
